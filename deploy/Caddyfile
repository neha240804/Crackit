# Caddy: HTTPS, the static site and the reverse proxy to the API, in one small config.
#
# SITE_ADDRESS (from .env) decides how it serves:
#   crackit.example.com  -> automatic HTTPS (Let's Encrypt certificate, renewed by Caddy;
#                           http:// redirects to https://). Needs DNS pointing here and
#                           ports 80 + 443 open.
#   :80                  -> plain HTTP, for a local test of the production stack.

{
	# Caddy's error log includes request headers. It hides Authorization and Cookie by
	# itself, but not X-Groq-Key: the user's own Groq key, which must never be written
	# anywhere on the server (CLAUDE.md, BYOK). Drop it from every log entry.
	log default {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers>X-Groq-Key delete
				request>headers>Authorization delete
			}
		}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Largest uploads: a resume (5 MB) and an answer recording (10 MB); a little headroom.
	request_body {
		max_size 12MB
	}

	header {
		# Only this site's own files may run or load (the app self-hosts its fonts and has no
		# third-party scripts). Inline style attributes are used by React components.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# The interview room needs the camera and microphone, but only for this site.
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# API -> the FastAPI container (port not published; reachable only on the compose network).
	handle /api/* {
		reverse_proxy backend:8001 {
			# AI calls (report generation, resume parsing on the strong model) can take a
			# minute or more on the free tier; give up only on a truly stuck request.
			transport http {
				response_header_timeout 300s
			}
		}
	}

	# Everything else: the React app. Unknown paths fall back to index.html so client-side
	# routes like /interviews/123 work on reload.
	handle {
		root * /srv/www
		# Vite gives built files content hashes, so they can be cached for a year;
		# index.html must always be re-checked so a deploy is picked up at once.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
