# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- App ---
# Set APP_ENV=production on a server: the API then refuses to start with the development
# defaults below (secret key, DB password, localhost CORS) and hides /docs.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Browser origins allowed to call the API, comma-separated (production: your real https URL)
CORS_ORIGINS=http://localhost:5174

# --- PostgreSQL (matches docker-compose.yml) ---
POSTGRES_USER=mockinterview
POSTGRES_PASSWORD=mockinterview
POSTGRES_DB=mockinterview
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# --- Qdrant ---
QDRANT_URL=http://localhost:6335

# --- LLM + speech-to-text: Groq free tier ---
# No server API key: every user adds their own free Groq key in Settings (bring-your-own-key
# only). Model IDs change over time: check https://console.groq.com/docs/models
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_STRONG_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3-turbo

# --- Interviewer voice: Groq Orpheus, local Kokoro-82M as fallback (data/models/kokoro/) ---
# groq = Orpheus on each user's own Groq key (scales: no server CPU), Kokoro as the fallback;
# kokoro = local only (about one interview at a time without gaps, see docs/DEPLOYMENT.md)
TTS_ENGINE=groq
KOKORO_MODEL=kokoro-v1.0.onnx
TTS_SPEED=1.1

# --- Embeddings: local FastEmbed (free, no API key, runs on CPU) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- LangSmith tracing (https://smith.langchain.com) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mock-interview-ai

# --- Production server only (docker-compose.prod.yml; see docs/DEPLOYMENT.md) ---
# On the server, set at least:
#   APP_ENV=production
#   SECRET_KEY=<64 random characters: openssl rand -hex 32>
#   POSTGRES_PASSWORD=<another random string: openssl rand -hex 24>
#   CORS_ORIGINS=https://your-domain.example
#   LANGSMITH_TRACING=false   (tracing is forced off in production anyway)
# POSTGRES_HOST / POSTGRES_PORT / QDRANT_URL above are overridden by the compose file.
# Your domain (Caddy gets the HTTPS certificate for it), or :80 for a plain-HTTP local test
SITE_ADDRESS=
# Ports Caddy listens on (80/443 on the server; change only for a local test)
HTTP_PORT=80
HTTPS_PORT=443
# Database backups: one every N hours, newest N kept (./backups)
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=7
